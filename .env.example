# Frontend Environment Variables
# Base URL for the backend API used by the Vite frontend
VITE_API_URL=http://localhost:5000/api
# Public Stripe key used by Stripe.js in the browser — safe to expose
VITE_STRIPE_PUBLIC_KEY=PROTECTED

# Backend Environment Variables
# Port the Next.js backend server listens on
PORT=5000
# Node environment flag
NODE_ENV=development
# Allowed origin for CORS on the backend
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string for Prisma
DATABASE_URL=PROTECTED

# JWT signing secrets — must be set in production
JWT_ACCESS_SECRET=PROTECTED
JWT_REFRESH_SECRET=PROTECTED
# JWT token expiry durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=PROTECTED
CLOUDINARY_API_KEY=PROTECTED
CLOUDINARY_API_SECRET=PROTECTED

# Stripe server-side credentials
STRIPE_SECRET_KEY=PROTECTED
STRIPE_WEBHOOK_SECRET=PROTECTED

# AI Provider Configuration (openai or gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=PROTECTED
GEMINI_API_KEY=PROTECTED
